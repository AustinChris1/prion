# ── Required ──────────────────────────────────────────────
# Identifies you to OpenAlex and Crossref. Any address you control.
OPENALEX_MAILTO=you@example.com

# ── Required from scripts/5-ingest.ts onward ──────────────
HYDRA_DB_API_KEY=

# ── Edge classification (optional) ────────────────────────
# Leave every key blank to run the no-network heuristic classifier.
# Set ONE of these and it is picked up automatically.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Force a provider: heuristic | groq | anthropic | xai | openai
# PRION_LLM_PROVIDER=groq
# Override the model for whichever provider is active.
# PRION_LLM_MODEL=llama-3.3-70b-versatile
